{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "NODE_ENV": "production"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APP_SCREEN_PROTECTION": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "1571031567"
      }
    }
  }
}

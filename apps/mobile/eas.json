{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "googleServicesFile": "google-services.json"
      },
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "NODE_ENV": "production"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "googleServicesFile": "google-services.json"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
# App
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/africover247

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Email
EMAIL_PROVIDER=resend
EMAIL_API_KEY=your_email_api_key
EMAIL_FROM=noreply@africover247.com

# Storage (S3-compatible)
S3_BUCKET_NAME=africover247
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_ENDPOINT=https://your-s3-endpoint.com

# Payment Gateway
PAYMENT_GATEWAY=paystack
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/callback

# Frontend URLs (for CORS)
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=placeholder
UPSTASH_REDIS_REST_TOKEN=placeholder

# App
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/africover247

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
AWS_REGION=eu-north-1
AWS_S3_BUCKET=placeholder
AWS_CLOUDFRONT_URL=placeholder

# --- Postmark ---
POSTMARK_API_TOKEN=placeholder
POSTMARK_FROM_EMAIL=noreply@africover247.com

# Payment Gateway
PAYMENT_GATEWAY=monnify
MONNIFY_API_KEY=placeholder
MONNIFY_SECRET_KEY=placeholder
MONNIFY_CONTRACT_CODE=placeholder
MONNIFY_ENV=sandbox
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/callback
SPLIT_PAYMENT_ENABLED=false

# Frontend URLs (for CORS)
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# --- Redis (AWS ElastiCache or Upstash) ---
REDIS_URL=placeholder

# KYC (Dojah)
DOJAH_APP_ID=placeholder_fill_after_dojah_account_created
DOJAH_PRIVATE_KEY=placeholder_fill_after_dojah_account_created
DOJAH_ENV=sandbox

# SMS (Termii)
TERMII_API_KEY=placeholder_fill_after_termii_account_created
TERMII_SENDER_ID=AfriCover
TERMII_ENV=sandbox
